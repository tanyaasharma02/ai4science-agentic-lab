# Copy to .env and fill in. Recommended: Vertex AI (uses your Google Cloud credits).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Alternative (no GCP project): an AI Studio key. Leave the three lines above
# unset/false if you use this.
# GOOGLE_API_KEY=...

# Optional overrides. Model availability differs per project, region and
# account age - e.g. brand-new accounts may not get gemini-2.5-* and are pointed
# at Gemini 3. `python setup/verify_env.py` probes your project and prints the
# exact lines to set if the defaults are not available to you.
# LAB_FAST_MODEL=gemini-2.5-flash          # or gemini-3-flash-preview
# LAB_STRONG_MODEL=gemini-3-flash-preview  # or gemini-2.5-pro / gemini-3-pro-preview
# GOOGLE_CLOUD_LOCATION=global             # needed for the gemini-3-* previews
# LAB_AUTO_APPROVE=1   # skip the human-approval prompt (demo recording only)
